# Local dev config for InvokeDB. Copy to .env (npm run setup does this for you).
# This file is sourced by bash, so ${VAR} references work.

IS_LOCAL=true
ENV=development

# The backend runs every role in one process locally
IS_HORIZON_BE=true
IS_HORIZON_PRC=true
IS_HORIZON_SB=true
IS_HORIZON_FS=true

# Optional. Leave blank locally; support requests go to the console. In production they're
# emailed to SUPPORT_EMAIL (needs Mailgun), with Telegram as the fallback.
SUPPORT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Uploaded/processed files (defaults to <repo>/.data)
HORIZON_FILE_SHARE=${HORIZON_ROOT}/.data

# Optional. Without MAILGUN_API_KEY, emails (welcome, reset password) are printed to the backend log.
MAILGUN_API_KEY=
MAILGUN_DN=mg.invokedb.com

# Optional. The AI features (generate rows, new table from a description) are on when it's set
# (console.anthropic.com, API keys); without it their buttons are hidden and /ai answers 503.
ANTHROPIC_API_KEY=

# Optional. "Continue with Google / GitHub" on the login and signup pages; each provider is on
# when its client ID and secret are both set. Create the OAuth apps with these callback URLs
# (HORIZON_BE_PUB_HTTP_URL below + /auth/<provider>/callback):
#   Google (console.cloud.google.com, APIs & Services > Credentials, OAuth client ID, Web
#   application): http://127.0.0.1:8001/auth/google/callback
#   GitHub (github.com/settings/developers, OAuth Apps): http://127.0.0.1:8001/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# postgres (local install, e.g. Postgres.app or brew)
HORIZON_POSTGRES_HOST=127.0.0.1
HORIZON_POSTGRES_PORT=5432
HORIZON_POSTGRES_DB=horizon
HORIZON_POSTGRES_USERNAME=postgres
HORIZON_POSTGRES_PASSWORD=

# mongo (local install)
HORIZON_MONGO_URI=mongodb://127.0.0.1:27017
HORIZON_MONGO_DB=horizon
HORIZON_MONGO_TRACKING_URI=mongodb://127.0.0.1:27017
HORIZON_MONGO_TRACKING_DB=horizon:tracking

# ports
HORIZON_FE_PUB_HTTP_PORT=8000
HORIZON_BE_PRIV_HTTP_PORT=8001
HORIZON_SB_PRIV_WS_PORT=9000

# public URLs the browser uses
HORIZON_FE_PUB_HTTP_URL=http://127.0.0.1:${HORIZON_FE_PUB_HTTP_PORT}
HORIZON_BE_PUB_HTTP_URL=http://127.0.0.1:${HORIZON_BE_PRIV_HTTP_PORT}
HORIZON_API_PUB_HTTP_URL=${HORIZON_BE_PUB_HTTP_URL}/api
HORIZON_PRC_PUB_HTTP_URL=${HORIZON_BE_PUB_HTTP_URL}
HORIZON_FS_PUB_HTTP_URL=${HORIZON_BE_PUB_HTTP_URL}
HORIZON_SB_PUB_WS_URL=ws://127.0.0.1:${HORIZON_SB_PRIV_WS_PORT}
HORIZON_SB_PRIV_WS_URL=${HORIZON_SB_PUB_WS_URL}

# Shared secret backend processes use to register with the websocket broker. Optional locally
# (a random one is generated per process); required anywhere else, and the same for every
# process. Generate one with: node -e "console.log(crypto.randomUUID())"
HORIZON_WS_SERVER_TOKEN=
