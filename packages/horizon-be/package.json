{
    "name": "horizon-be",
    "version": "2.0.360",
    "description": "description",
    "author": "Steve Hetzel",
    "license": "MIT",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "format": "prettier --write \"src/**/*.ts\"",
        "start": "IS_TS_NODE=true npm run start:dev",
        "start:dev": "nodemon",
        "start:debug": "nodemon --config nodemon-debug.json",
        "prestart:prod": "rimraf dist && tsc",
        "start:prod": "node dist/main.js",
        "lint": "tslint -p tsconfig.json -c tslint.json",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js --config src/database/ormconfig.ts",
        "migration:create": "npm run typeorm migration:create -- -n",
        "migration:run": "npm run typeorm migration:run",
        "migration:revert": "npm run typeorm migration:revert"
    },
    "dependencies": {
        "@nestjs/common": "^7.3.2",
        "@nestjs/core": "^7.3.2",
        "@nestjs/passport": "^7.1.0",
        "@nestjs/platform-express": "^7.3.2",
        "@nestjs/platform-ws": "^7.3.2",
        "@nestjs/swagger": "^4.3.2",
        "@nestjs/typeorm": "^7.1.0",
        "@nestjs/websockets": "^7.3.2",
        "@pauleliet/winston-pg-native": "^4.4.0",
        "@slack/webhook": "^5.0.3",
        "@types/mongodb": "^3.5.2",
        "bcrypt": "^4.0.1",
        "camelcase": "^5.3.1",
        "class-transformer": "^0.2.3",
        "class-validator": "^0.11.0",
        "csv-parse": "^4.8.8",
        "mailgun-js": "^0.22.0",
        "module-alias": "^2.2.2",
        "moment": "^2.24.0",
        "mongodb-backup-4x": "^3.2.1",
        "mongodb-restore": "^1.6.2",
        "mongoose": "^5.9.3",
        "multer": "^1.4.2",
        "passport": "^0.4.1",
        "passport-http-bearer": "^1.0.1",
        "pg": "^7.18.2",
        "reflect-metadata": "^0.1.13",
        "request": "^2.88.2",
        "rimraf": "^3.0.2",
        "rxjs": "^6.5.4",
        "snake-case": "^3.0.3",
        "stripe": "^8.50.0",
        "typeorm": "^0.2.24",
        "typescript": "^3.8.3",
        "uuid": "^7.0.2",
        "winston": "^3.3.3",
        "winston-slack-webhook-transport": "^1.2.4",
        "ws": "^7.3.1"
    },
    "devDependencies": {
        "@nestjs/testing": "^6.11.11",
        "@types/express": "^4.17.3",
        "@types/jest": "^25.1.3",
        "@types/node": "^13.7.7",
        "@types/supertest": "^2.0.8",
        "jest": "^25.1.0",
        "nodemon": "^2.0.2",
        "prettier": "^1.19.1",
        "supertest": "^4.0.2",
        "ts-jest": "^25.2.1",
        "ts-loader": "^6.2.1",
        "ts-node": "^8.6.2",
        "tsconfig-paths": "^3.9.0",
        "tslint": "6.0.0"
    },
    "prettier": {
        "printWidth": 100,
        "tabWidth": 4,
        "singleQuote": true,
        "semi": true
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".spec.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "_moduleAliases": {
        "@app": "./dist"
    }
}
