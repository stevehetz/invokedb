{
    "name": "horizon-fe",
    "version": "2.0.371",
    "private": true,
    "scripts": {
        "start": "npm run env public && npm run serve:dev",
        "env": "node env.js",
        "build": "vue-cli-service build",
        "lint": "vue-cli-service lint",
        "serve:dev": "vue-cli-service serve",
        "serve:deploy": "npm run env dist && node internals/server.js",
        "test:unit": "vue-cli-service test:unit",
        "format": "bash ./internals/format.sh"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^5.13.0",
        "EventEmitter": "^1.0.0",
        "ag-grid-community": "^22.1.1",
        "ag-grid-vue": "^22.1.1",
        "copy-to-clipboard": "^3.3.1",
        "element-ui": "^2.13.0",
        "express": "^4.17.1",
        "highlight.js": "^10.1.0",
        "jqtree": "^1.4.12",
        "jquery": "^3.5.1",
        "js-cookie": "^2.2.1",
        "jsonfile": "^6.0.0",
        "lodash": "^4.17.15",
        "moment": "^2.24.0",
        "moment-timezone": "^0.5.28",
        "postcss-nested": "^4.2.1",
        "rxjs": "^6.5.4",
        "rxjs-compat": "^6.5.4",
        "split.js": "^1.5.11",
        "vue": "^2.6.11",
        "vue-property-decorator": "^8.4.0",
        "vue-router": "^3.1.6"
    },
    "devDependencies": {
        "@beyonk/google-fonts-webpack-plugin": "^1.5.0",
        "@vue/cli-plugin-babel": "^4.2.3",
        "@vue/cli-plugin-eslint": "^4.2.3",
        "@vue/cli-plugin-unit-jest": "^4.2.3",
        "@vue/cli-service": "^4.2.3",
        "@vue/eslint-config-prettier": "^6.0.0",
        "@vue/test-utils": "^1.0.0-beta.31",
        "babel-core": "7.0.0-bridge.0",
        "babel-eslint": "^10.1.0",
        "babel-jest": "^25.1.0",
        "eslint": "^6.8.0",
        "eslint-plugin-prettier": "^3.1.2",
        "eslint-plugin-vue": "^6.2.1",
        "node-ensure": "0.0.0",
        "node-sass": "^4.13.1",
        "rimraf": "^3.0.2",
        "sass-loader": "^8.0.2",
        "vue-template-compiler": "^2.6.11"
    },
    "prettier": {
        "printWidth": 80,
        "tabWidth": 4,
        "singleQuote": true,
        "semi": true,
        "arrowParens": "avoid",
        "trailingComma": "none"
    },
    "eslintConfig": {
        "root": true,
        "globals": {
            "_": true
        },
        "env": {
            "browser": true,
            "commonjs": true,
            "es6": true,
            "jquery": true,
            "node": true
        },
        "extends": [
            "plugin:vue/essential",
            "@vue/prettier"
        ],
        "rules": {
            "no-console": 0,
            "no-unused-vars": 0
        },
        "parserOptions": {
            "parser": "babel-eslint"
        }
    },
    "postcss": {
        "plugins": {
            "autoprefixer": {}
        }
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not ie <= 8"
    ],
    "jest": {
        "moduleFileExtensions": [
            "js",
            "jsx",
            "json",
            "vue"
        ],
        "transform": {
            "^.+\\.vue$": "vue-jest",
            ".+\\.(css|styl|less|sass|scss|png|jpg|ttf|woff|woff2)$": "jest-transform-stub",
            "^.+\\.jsx?$": "babel-jest"
        },
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/src/$1"
        },
        "snapshotSerializers": [
            "jest-serializer-vue"
        ],
        "testMatch": [
            "**/tests/unit/**/*.spec.(js|jsx|ts|tsx)|**/__tests__/*.(js|jsx|ts|tsx)"
        ],
        "testURL": "http://localhost/"
    }
}
