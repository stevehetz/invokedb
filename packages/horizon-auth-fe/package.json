{
    "name": "horizon-auth-fe",
    "version": "2.0.371",
    "private": true,
    "scripts": {
        "start": "npm run env public && npm run serve:dev",
        "env": "node env.js",
        "build": "vue-cli-service build",
        "lint": "vue-cli-service lint",
        "serve:dev": "vue-cli-service serve",
        "format": "prettier --write 'src/**/*.{js,vue}'"
    },
    "dependencies": {
        "element-ui": "^2.13.0",
        "eslint-plugin-prettier": "^3.1.2",
        "highlight.js": "^10.0.3",
        "js-cookie": "^2.2.1",
        "rxjs": "^6.5.4",
        "rxjs-compat": "^6.5.4",
        "vue": "^2.6.11",
        "vue-router": "^3.1.6"
    },
    "devDependencies": {
        "@vue/cli-plugin-babel": "^4.2.3",
        "@vue/cli-plugin-eslint": "^4.2.3",
        "@vue/cli-service": "^4.2.3",
        "@vue/eslint-config-prettier": "^6.0.0",
        "babel-eslint": "^10.1.0",
        "eslint": "^6.8.0",
        "eslint-plugin-vue": "^6.2.1",
        "sass": "~1.32.13",
        "sass-loader": "^8.0.2",
        "vue-template-compiler": "^2.6.11"
    },
    "prettier": {
        "printWidth": 100,
        "tabWidth": 4,
        "singleQuote": true,
        "semi": true
    },
    "eslintConfig": {
        "root": true,
        "env": {
            "browser": true,
            "commonjs": true,
            "es6": true,
            "jquery": true,
            "node": true
        },
        "extends": [
            "plugin:vue/essential",
            "eslint:recommended",
            "@vue/prettier"
        ],
        "rules": {
            "no-console": 0,
            "no-unused-vars": 0,
            "no-prototype-builtins": 0
        },
        "parserOptions": {
            "parser": "babel-eslint"
        }
    },
    "postcss": {
        "plugins": {
            "autoprefixer": {}
        }
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not ie <= 8"
    ]
}
