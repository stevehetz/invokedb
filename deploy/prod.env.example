# Production config for deploy/compose.yaml. `deploy/deploy.sh init-env` copies this to
# deploy/prod.env (gitignored, synced by scripts/secrets.sh) and fills in random passwords.
# Passwords go into connection URIs, so keep them URL-safe (hex).

# The server (root over SSH with your key)
DEPLOY_HOST=
DEPLOY_SSH_KEY=~/.ssh/id_rsa

# Public hostnames (Cloudflare DNS-only A records to the server) and the Let's Encrypt contact
SITE_DOMAIN=invokedb.com
API_DOMAIN=api.invokedb.com
WS_DOMAIN=ws.invokedb.com
ACME_EMAIL=

# Generated by init-env. Changing a DB password after the first start needs the change made
# inside the database too.
POSTGRES_PASSWORD=
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
HORIZON_WS_SERVER_TOKEN=
# Encrypts each account's two-factor (authenticator app) secret (#214). Unset: nobody can turn
# two-factor sign-in on. Never change it once set: the authenticator apps already set up stop
# working (their recovery codes still do).
HORIZON_TOTP_KEY=

# Off-site backups (deploy/backup.sh, see deploy/README.md). BACKUP_PASSPHRASE encrypts the
# dumps and is generated by init-env: without it the backups can't be read, so keep this file
# synced (npm run secrets:push). The rest come from the DigitalOcean Spaces bucket and its
# access key.
BACKUP_PASSPHRASE=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=
BACKUP_KEEP_DAYS=30
# Healthchecks.io check URL (https://hc-ping.com/<uuid>); optional but it's the missed-run alert
HEALTHCHECK_URL=

# Sizing for a 4 GB server. On 8 GB, MONGO_CACHE_GB=2 and PRC_CPUS=2 are reasonable.
MONGO_CACHE_GB=0.75
PRC_CPUS=1

# Optional. Without Mailgun, emails (welcome, password reset) go to the api container's log.
MAILGUN_API_KEY=
MAILGUN_DN=

# Optional. The AI features (#148, #149) are on when ANTHROPIC_API_KEY (a key from the
# Anthropic Console's InvokeDB workspace, which has its own spend limit) and
# HORIZON_AI_MONTHLY_BUDGET_USD (what the whole server may spend per UTC month; alerts at 50, 80
# and 100%, paused at 100%; docs/PRICING.md 3.5) are both set. HORIZON_AI_MODEL overrides the
# default model (Haiku). Never set ANTHROPIC_BASE_URL here: it's only for the smoke tests' stub.
ANTHROPIC_API_KEY=
HORIZON_AI_MONTHLY_BUDGET_USD=
HORIZON_AI_MODEL=

# The admin area at /app/admin (#277; docs/OPERATIONS.md "Admin area"): comma-separated emails
# of the admins. Each account also needs a verified email and two-factor sign-in on (which needs
# HORIZON_TOTP_KEY). Empty: nobody is an admin and its routes answer 404.
HORIZON_ADMIN_EMAILS=

# Optional. Billing through Stripe (#129; docs/OPERATIONS.md "Stripe"): the live secret key
# (sk_live_...) and the signing secret (whsec_...) of the webhook endpoint
# https://<API_DOMAIN>/billing/webhook. Billing is on when both are set; empty, the upgrade
# buttons are hidden. The prices are found by their lookup keys (invokedb_starter_month, ...).
# Never set STRIPE_API_BASE here: it's only for the smoke tests' stub.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. Google / GitHub sign-in; each is on when its client ID and secret are both set.
# Callback URLs to register: https://<API_DOMAIN>/auth/google/callback and
# https://<API_DOMAIN>/auth/github/callback (see .env.example for where to create the apps).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Contact-form requests are emailed (through Mailgun) to SUPPORT_EMAIL, with Reply-To
# set to the sender. Telegram is the fallback when Mailgun refuses the email; with neither, they
# only go to the log. See deploy/README.md.
SUPPORT_EMAIL=support@invokedb.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
