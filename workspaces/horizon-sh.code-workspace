{
    "folders": [
        { "name": "horizon", "path": ".." },
        { "name": "horizon-be", "path": "../packages/horizon-be" },
        { "name": "horizon-fe", "path": "../packages/horizon-fe" },
        { "name": "horizon-auth-fe", "path": "../packages/horizon-auth-fe" }
    ],
    "settings": {
        // Prettier (root config + root prettier 3) formats on save. Each folder's
        // .vscode/settings.json points prettier.prettierPath at the root install.
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "prettier.requireConfig": true,
        "files.exclude": {
            "**/.idea": true
        },
        "explorer.compactFolders": false
    },
    "extensions": {
        "recommendations": ["esbenp.prettier-vscode", "editorconfig.editorconfig"]
    }
}
