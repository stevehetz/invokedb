{
    "name": "horizon-be",
    "version": "2.0.371",
    "description": "InvokeDB backend (NestJS API, CSV processor, websocket broker)",
    "private": true,
    "license": "UNLICENSED",
    "author": "Steve Hetzel",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stevehetz/invokedb.git",
        "directory": "packages/horizon-be"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "start": "IS_TS_NODE=true npm run start:dev",
        "start:dev": "nodemon",
        "lint": "eslint src",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
        "migration:create": "bash -c 'typeorm-ts-node-commonjs migration:create src/database/migration/$0'",
        "migration:run": "npm run typeorm migration:run",
        "migration:revert": "npm run typeorm migration:revert",
        "onboarding:funnel": "ts-node src/cli/onboarding-funnel.ts"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^1.14.0",
        "@nestjs/common": "^12.6.0",
        "@nestjs/core": "^12.6.0",
        "@nestjs/passport": "^12.0.2",
        "@nestjs/platform-express": "^12.6.0",
        "@nestjs/typeorm": "^12.0.3",
        "bcryptjs": "^3.0.3",
        "camelcase": "^6.3.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "csv-parse": "^7.0.3",
        "module-alias": "^2.2.3",
        "mongodb": "^7.9.1",
        "passport": "^0.7.0",
        "passport-github2": "^0.1.12",
        "passport-google-oauth20": "^2.0.0",
        "passport-http-bearer": "^1.0.1",
        "pg": "^8.16.3",
        "qrcode-generator": "^2.0.4",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "snake-case": "^3.0.4",
        "stripe": "^23.2.0",
        "typeorm": "^1.1.3",
        "uuid": "^14.0.3",
        "winston": "^3.17.0",
        "ws": "^8.18.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.3",
        "@types/jest": "^30.0.0",
        "@types/multer": "^2.0.0",
        "@types/node": "^22.18.0",
        "@types/passport-github2": "^1.2.9",
        "@types/passport-google-oauth20": "^2.0.17",
        "@types/ws": "^8.18.1",
        "eslint": "^10.15.0",
        "globals": "^17.14.0",
        "jest": "^30.5.2",
        "nodemon": "^3.1.10",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.74.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".spec.ts$",
        "transform": {
            "^.+\\.ts$": [
                "ts-jest",
                {
                    "tsconfig": "<rootDir>/../tsconfig.spec.json"
                }
            ],
            "/node_modules/@nestjs/.+\\.js$": "<rootDir>/../jest-esm-transform.js"
        },
        "transformIgnorePatterns": [
            "/node_modules/(?!@nestjs/)"
        ],
        "moduleNameMapper": {
            "^@app/(.*)$": "<rootDir>/$1"
        },
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "_moduleAliases": {
        "@app": "./dist"
    }
}
