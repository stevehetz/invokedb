{
    "name": "horizon-fe",
    "version": "2.0.371",
    "private": true,
    "scripts": {
        "start": "npm run env public && vite",
        "env": "node env.js",
        "build": "vite build",
        "preview": "npm run env dist && vite preview",
        "lint": "eslint --ext .js,.vue src"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^5.13.0",
        "ag-grid-community": "^22.1.1",
        "ag-grid-vue": "^22.1.1",
        "copy-to-clipboard": "^3.3.1",
        "element-ui": "^2.13.0",
        "EventEmitter": "^1.0.0",
        "express": "^4.17.1",
        "highlight.js": "^10.1.0",
        "jqtree": "^1.4.12",
        "jquery": "^3.5.1",
        "js-cookie": "^2.2.1",
        "jsonfile": "^6.0.0",
        "lodash": "^4.17.15",
        "moment": "^2.24.0",
        "moment-timezone": "^0.5.28",
        "postcss-nested": "^4.2.1",
        "rxjs": "^6.5.4",
        "rxjs-compat": "^6.5.4",
        "split.js": "^1.5.11",
        "vue": "^2.7.16",
        "vue-property-decorator": "^8.4.0",
        "vue-router": "^3.1.6"
    },
    "devDependencies": {
        "@vitejs/plugin-vue2": "^2.3.4",
        "@vue/eslint-config-prettier": "^6.0.0",
        "autoprefixer": "^10.4.21",
        "babel-eslint": "^10.1.0",
        "eslint": "^6.8.0",
        "eslint-plugin-prettier": "^3.1.2",
        "eslint-plugin-vue": "^6.2.1",
        "sass": "~1.32.13",
        "vite": "^6.4.6"
    },
    "eslintConfig": {
        "root": true,
        "globals": {
            "_": true
        },
        "env": {
            "browser": true,
            "commonjs": true,
            "es6": true,
            "jquery": true,
            "node": true
        },
        "extends": [
            "plugin:vue/essential",
            "@vue/prettier"
        ],
        "rules": {
            "no-console": 0,
            "no-unused-vars": 0,
            "prettier/prettier": 0
        },
        "parserOptions": {
            "parser": "babel-eslint"
        }
    },
    "postcss": {
        "plugins": {
            "autoprefixer": {}
        }
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not ie <= 8"
    ]
}
