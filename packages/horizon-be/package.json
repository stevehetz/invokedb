{
    "name": "horizon-be",
    "version": "2.0.371",
    "description": "description",
    "author": "Steve Hetzel",
    "license": "MIT",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "start": "IS_TS_NODE=true npm run start:dev",
        "start:dev": "nodemon",
        "start:debug": "nodemon --config nodemon-debug.json",
        "prestart:prod": "rm -rf dist && tsc -p tsconfig.build.json",
        "start:prod": "node dist/main.js",
        "lint": "tslint -p tsconfig.json -c tslint.json",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
        "migration:create": "bash -c 'typeorm-ts-node-commonjs migration:create src/database/migration/$0'",
        "migration:run": "npm run typeorm migration:run",
        "migration:revert": "npm run typeorm migration:revert"
    },
    "dependencies": {
        "@nestjs/common": "^11.1.6",
        "@nestjs/core": "^11.1.6",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.6",
        "@nestjs/typeorm": "^11.0.3",
        "@slack/webhook": "^7.0.6",
        "bcryptjs": "^2.4.3",
        "camelcase": "^6.3.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.4",
        "csv-parse": "^5.6.0",
        "module-alias": "^2.2.3",
        "moment": "^2.30.1",
        "mongodb": "^6.22.0",
        "passport": "^0.7.0",
        "passport-http-bearer": "^1.0.1",
        "pg": "^8.16.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "snake-case": "^3.0.4",
        "stripe": "^8.50.0",
        "typeorm": "^0.3.31",
        "uuid": "^11.1.0",
        "winston": "^3.17.0",
        "winston-slack-webhook-transport": "^1.2.4",
        "ws": "^8.18.3"
    },
    "devDependencies": {
        "@nestjs/testing": "^11.1.6",
        "@types/express": "^5.0.3",
        "@types/jest": "^29.5.14",
        "@types/multer": "^2.0.0",
        "@types/node": "^22.18.0",
        "@types/supertest": "^6.0.3",
        "@types/ws": "^8.18.1",
        "jest": "^29.7.0",
        "nodemon": "^3.1.10",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "tslint": "6.1.3",
        "typescript": "^5.9.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".spec.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "_moduleAliases": {
        "@app": "./dist"
    },
    "optionalDependencies": {
        "@pauleliet/winston-pg-native": "^4.4.0"
    }
}
