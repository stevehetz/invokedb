{
    "name": "horizon",
    "version": "2.0.371",
    "author": "Steve Hetzel",
    "description": "Web documents",
    "license": "ISC",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@bitbucket.org-shetzel84:shetzel84/horizon.git"
    },
    "scripts": {
        "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
        "postinstall": "bash scripts/install-packages.sh",
        "setup": "bash scripts/setup.sh",
        "dev": "bash scripts/dev.sh",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "db:setup": "bash scripts/db-setup.sh",
        "db:reset": "bash scripts/db-setup.sh --reset",
        "db:demo": "bash scripts/db-demo.sh",
        "secrets:pull": "bash scripts/secrets.sh pull",
        "secrets:push": "bash scripts/secrets.sh push",
        "secrets:status": "bash scripts/secrets.sh status",
        "migration:create": "bash scripts/be-run.sh migration:create",
        "migration:run": "bash scripts/be-run.sh migration:run",
        "migration:revert": "bash scripts/be-run.sh migration:revert",
        "base:construct": "cd ops/azure-base && bash _run.sh",
        "prod:docker-build": "cd ops/azure-prod/commands && bash docker-build.sh",
        "prod:docker-push": "cd ops/azure-prod/commands && bash docker-push.sh",
        "prod:aks-credentials": "cd ops/azure-prod/commands/aks && bash aks-credentials.sh ",
        "prod:aks-context": "cd ops/azure-prod/commands/aks && bash aks-context.sh ",
        "prod:aks-start": "cd ops/azure-prod/commands/aks && bash aks-start.sh ",
        "prod:aks-stop": "cd ops/azure-prod/commands/aks && bash aks-stop.sh ",
        "prod:aks-restart": "cd ops/azure-prod/commands/aks && bash aks-restart-deploys.sh ",
        "prod:aks-dashboard": "cd ops/azure-prod/commands/aks && bash aks-dashboard.sh ",
        "prod:aks-logs": "cd ops/azure-prod/commands/aks && bash aks-logs.sh ",
        "prod:share-clear": "cd ops/azure-prod/commands/azure-file-share && bash fileshare-clear-dir.sh ",
        "prod:share-mount": "cd ops/azure-prod/commands/azure-file-share && bash fileshare-mount.sh ",
        "prod:share-unmount": "cd ops/azure-prod/commands/azure-file-share && bash fileshare-unmount.sh ",
        "prod:setupdbs": "cd ops/azure-prod/commands/db && bash setupdbs.sh",
        "prod:setupdbs-demo": "cd ops/azure-prod/commands/db && bash restoredbs.sh demo",
        "prod:restoredbs": "cd ops/azure-prod/commands/db && bash restoredbs.sh",
        "prod:backupdbs": "cd ops/azure-prod/commands/db && bash backupdbs.sh",
        "prod:migrate-postgres": "cd ops/azure-prod/commands/db && bash migrate-postgres.sh",
        "prod:drop-tracking-db": "cd ops/azure-prod/commands/db && bash drop-mongo-tracking.sh",
        "prod:ops-connect": "cd ops/azure-prod/commands && bash ops-cmd.sh '/bin/bash'",
        "prod:proxy-connect": "cd ops/azure-prod/commands/proxy-server && bash connect.sh",
        "prod:proxy-fs-connect": "cd ops/azure-prod/commands/proxy-server && bash connect-fs.sh",
        "prod:construct": "cd ops/azure-prod/construct && bash _run.sh",
        "prod:deploy": "cd ops/azure-prod/commands && bash deploy.sh",
        "prod:kube-connect": "cd ops/azure-prod/commands/kubectl && bash connect.sh",
        "prod:scale-nodes": "cd ops/azure-prod/commands/aks && bash aks-scale-nodes.sh",
        "prod:scale-pods": "cd ops/azure-prod/commands && bash scale-pods.sh",
        "prod:scale-disk": "cd ops/azure-prod/commands && bash scale-disk.sh",
        "prod:snapshot": "cd ops/azure-prod/commands && bash snapshot.sh",
        "prod:bridge": "cd ops/azure-prod/commands/remote-bridge && bash up.sh"
    },
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "concurrently": "^8.2.2",
        "playwright": "1.56.1",
        "prettier": "3.9.10"
    }
}
