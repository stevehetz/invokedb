	email {$ACME_EMAIL}
}

# The site and the app (an SPA: unknown paths fall back to index.html)
{$SITE_DOMAIN} {
	encode zstd gzip
	root * /srv
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@runtime path /env.txt /index.html
	header @runtime Cache-Control no-store
	try_files {path} /index.html
	file_server
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# Example apps built on the API (#340). The React support desk is its own container (the
# react-demo service), which serves its build, its API proxy, the webhook and the live feed.
# Server-sent events (/react-demo/events) are flushed as they come (reverse_proxy does that for
# text/event-stream). Caddy sets X-Forwarded-For to the client's address, which the server's
# rate limits use.
examples.{$SITE_DOMAIN} {
	# Not the event stream: compressing it would hold events back until a buffer fills
	@compress not path /react-demo/events
	encode @compress zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	handle /react-demo* {
		reverse_proxy react-demo:8080
	}
	handle {
		redir * /react-demo/ temporary
	}
}

# The backend's internal routes and /api/v1. They sit at the root, so they get their own host.
{$API_DOMAIN} {
	encode zstd gzip
	header -Server
	reverse_proxy api:8001
}

# The websocket broker (reverse_proxy upgrades websocket connections by itself)
{$WS_DOMAIN} {
	reverse_proxy api:9000
}
