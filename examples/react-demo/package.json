{
  "name": "invokedb-react-demo",
  "private": true,
  "version": "1.0.0",
  "description": "A support desk built with React on InvokeDB: queries, links, a kanban and a live feed driven by webhooks",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint . && tsc -p tsconfig.server.json",
    "test": "node --test \"server/test/*.test.mjs\"",
    "check": "npm run lint && npm test && npm run build",
    "start": "node server/index.mjs",
    "reset": "node server/reset-cli.mjs",
    "seed": "node seed/generate.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.16.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "singleQuote": true,
    "semi": true,
    "arrowParens": "avoid",
    "trailingComma": "none"
  }
}
