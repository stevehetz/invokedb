{
  "name": "invokedb",
  "version": "2.0.0",
  "description": "InvokeDB JavaScript/TypeScript client (Node 18+ and browsers)",
  "license": "ISC",
  "author": "Steve Hetzel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevehetz/invokedb.git",
    "directory": "examples/invokedb-node"
  },
  "bugs": {
    "url": "https://github.com/stevehetz/invokedb/issues"
  },
  "homepage": "https://github.com/stevehetz/invokedb/tree/main/examples/invokedb-node#readme",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/es/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && echo '{\"type\":\"module\"}' > dist/es/package.json",
    "start": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "singleQuote": true,
    "semi": true,
    "arrowParens": "avoid",
    "trailingComma": "none"
  }
}
