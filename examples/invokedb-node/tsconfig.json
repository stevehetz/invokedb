{
  "compilerOptions": {
    "outDir": "dist/es",
    "module": "es2020",
    "target": "es2018",
    "lib": ["es2018", "dom"],
    "types": [],
    "declaration": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
